# ====================================================================
# TASKBAR OS — SERVER ENVIRONMENT CONFIGURATION
# ====================================================================

# Google Gemini API Key (Required for cloud Gemini integration)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Gemini Free Tier Model (Default: gemini-1.5-flash)
# Eligible free models: gemini-1.5-flash, gemini-2.0-flash
GEMINI_MODEL=gemini-1.5-flash

# Active Provider: gemini | openrouter | local_deterministic
AI_PROVIDER=gemini

# Free Tier Rate Limit Guardrails
AI_RATE_LIMIT_RPM=15
AI_DAILY_LIMIT=1500

# Optional OpenRouter Integration (Admin configurable only)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Server Port (for standalone backend)
PORT=5174
