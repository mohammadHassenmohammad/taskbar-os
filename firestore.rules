rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check user ownership
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile document and all nested intelligence subcollections (data/state_v4, etc.)
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Global leaderboards or public stats (read-only for authenticated, writable only via server or verified user profile)
    match /leaderboards/{document=**} {
      allow read: if isAuthenticated();
      allow write: if false; // Only server or admin write
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
